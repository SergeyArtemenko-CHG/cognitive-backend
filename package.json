{
  "name": "cognitive-battery-api",
  "version": "1.0.0",
  "private": true,
  "description": "Isolated Express API for the Flutter cognitive trainer",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
